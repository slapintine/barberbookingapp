NODE_ENV=production
PRODUCT_MARKETPLACE_ENABLED=false
PORT=5000
HOST=127.0.0.1
LOG_LEVEL=info
APP_PUBLIC_URL=https://queless.org
APP_URL=https://queless.org
FRONTEND_URL=https://queless.org
BASE_URL=https://queless.org
API_BASE_URL=https://queless.org/api
CLIENT_URL=https://queless.org,https://www.queless.org
DEV_CLIENT_URL=
ANDROID_APP_VERSION=1.0.0
ANDROID_APK_URL=https://queless.org/downloads/queless-latest.apk
ANDROID_RELEASE_NOTES=Initial Queless Android release
ANDROID_FORCE_UPDATE=false
# Optional display metadata. Set these after uploading the signed release APK.
ANDROID_RELEASE_DATE=
ANDROID_APK_SIZE=
JWT_SECRET=Queless-local-dev-secret-key-2026-keep-this-long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Choose one database mode. PostgreSQL is recommended for production.
DB_CLIENT=postgres
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME
DATABASE_SSL=true
IMAGE_STORAGE_DIR=/var/www/queless.org/shared/uploads
FIREBASE_SERVICE_ACCOUNT_JSON=

# SQLite fallback only if you intentionally deploy with SQLite on the VPS.
# DB_CLIENT=sqlite
# DB_PATH=./src/db/barber_app.sqlite

RESEND_API_KEY=
EMAIL_FROM=Queless <info@queless.org>

# Queless Provider Coach AI. Keep GEMINI_API_KEY in the active backend .env only.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PROVIDER_COACH_DAILY_LIMIT=20
# Optional fallback provider if explicitly selected. Not required for Gemini-first mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SHORTCODE=
AFRICASTALKING_ENV=production
AFRICASTALKING_ALLOW_LIVE_SEND=false
AFRICASTALKING_LIFECYCLE_SMS_ENABLED=false
AFRICASTALKING_SMS_AUTO_REPLY_ENABLED=false
AFRICASTALKING_DEFAULT_AUTO_REPLY=Thank you for contacting Queless. We have received your message.
# Optional diagnostic recipient. Keep this unset until an approved test number is available.
SMS_TEST_PHONE=

BOOKING_ONLINE_PAYMENTS_ENABLED=false
BOOKING_WALLET_PAYMENTS_ENABLED=true
PROVIDER_FREE_TRIALS_ENABLED=false
# REAL/LIVE MTN payments. Must be "live" in production (NOT "mock" or "sandbox").
MOBILE_MONEY_MODE=live
ENABLE_MOCK_PAYMENTS=false
MOBILE_MONEY_DEFAULT_PROVIDER=mtn
MOBILE_MONEY_CURRENCY=UGX
MOBILE_MONEY_BASE_URL=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=
MOBILE_MONEY_COLLECTION_URL=
MOBILE_MONEY_VERIFICATION_URL=
MOBILE_MONEY_DISBURSEMENT_URL=
MOBILE_MONEY_CALLBACK_URL=https://queless.org/api/payments/mtn/callback?token=replace-with-the-same-callback-token
MOBILE_MONEY_WEBHOOK_TOKEN=replace-with-a-32-plus-character-random-callback-token
PROVIDER_PROMO_FREE_CODE=
PROVIDER_PROMO_20_CODE=
PROVIDER_PROMO_EXPIRES_AT=
CUSTOMER_PREMIUM_PROMO_FREE_CODE=
CUSTOMER_PREMIUM_PROMO_20_CODE=
CUSTOMER_PREMIUM_PROMO_EXPIRES_AT=

# (6) Backend route is POST /api/payments/mtn/callback — register this EXACT URL
#     in the MTN Developer Portal. MTN MoMo callbacks do not add a custom auth
#     header, so (7) if MOBILE_MONEY_WEBHOOK_TOKEN is set, register the full
#     tokenized URL below and keep ?token= equal to MOBILE_MONEY_WEBHOOK_TOKEN.
#     (Either way, the backend also confirms status by polling, so activation is
#     safe.) To use the plain URL instead, leave the webhook token empty.
MTN_CALLBACK_URL=https://queless.org/api/payments/mtn/callback?token=replace-with-the-same-callback-token
MTN_WEBHOOK_URL=https://queless.org/api/payments/webhooks/mtn

# ─── MTN Uganda — REAL / LIVE production (OAuth via api.mtn.com) ──────────────
# (1) Real/live MTN Uganda uses MOBILE_MONEY_MODE=live (set above).
# (2) Production AUTHENTICATES with the Consumer Key + Secret from your approved
#     MTN MoMo Developer Portal app. Set these ONLY on the server, never in git.
# (10) Rotate the Consumer Key/Secret in the portal before deployment if they
#      were ever exposed.
MTN_CONSUMER_KEY=<set-on-server>
MTN_CONSUMER_SECRET=<set-on-server>
# (3) The actual RequestToPay call STILL needs the Collections product key
#     (Primary) — sent as Ocp-Apim-Subscription-Key. Keep it set.
MTN_COLLECTION_SUBSCRIPTION_KEY=<set-on-server>
# (4) Uganda live currency MUST be UGX.
# (5) Target environment should be "mtnuganda" unless MTN officially gives you a
#     different value during production onboarding.
MTN_CURRENCY=UGX
MTN_TARGET_ENVIRONMENT=mtnuganda
#
# (8) With the two Consumer credentials set and the variables below LEFT BLANK,
#     the backend auto-targets production https://api.mtn.com and derives the
#     collection/verification URLs. Do NOT set these to sandbox values
#     (sandbox.momodeveloper.mtn.com) in production unless MTN officially instructs:
# MTN_BASE_URL=          # leave blank -> auto https://api.mtn.com
# MTN_COLLECTION_URL=    # leave blank -> auto .../collection/v1_0/requesttopay
# MTN_VERIFICATION_URL=  # leave blank -> auto .../collection/v1_0/requesttopay
# MTN_DISBURSEMENT_URL=  # leave blank -> auto .../disbursement/v1_0/transfer
# MTN_API_USER_ID=       # sandbox-only API-user flow — leave blank in production
# MTN_API_KEY=           # sandbox-only API-user flow — leave blank in production
# Only needed if you ever pay providers out via MTN disbursement (not for Collections):
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=
# (9) Never commit a real .env. This file is documentation only.

AIRTEL_ENABLED=false
AIRTEL_CALLBACK_URL=https://queless.org/api/payments/airtel/callback?token=replace-with-the-same-callback-token
AIRTEL_WEBHOOK_URL=https://queless.org/api/payments/webhooks/airtel
AIRTEL_BASE_URL=
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_API_KEY=
AIRTEL_API_SECRET=
AIRTEL_COLLECTION_URL=
AIRTEL_VERIFICATION_URL=
AIRTEL_DISBURSEMENT_URL=
